#!/bin/sh
# A live Relay you can poke at, kept out of ~/.relay.
#
#   scripts/live reset          throw it away and build it again from live/seed
#   scripts/live stop           stop the daemon of the live home
#   scripts/live env            the exports, for `eval "$(scripts/live env)"`
#   scripts/live <rl args…>     rl against the live home (no args: the TUI)
#
# The home is live/home (RELAY_HOME), the workspace is live/ws, and
# code/fixtures goes first on PATH so `claude` is the recorded player
# (CLAUDE_PLAYER_SPEED=0 plays it with no waits). RELAY_LIVE_REAL_CLAUDE=1
# leaves your real claude in place instead.
set -e

self=$0
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
root=$(cd "$(dirname "$self")/.." && pwd)
live=$root/live
seed=$live/seed

RELAY_HOME=$live/home
export RELAY_HOME
if [ -z "$RELAY_LIVE_REAL_CLAUDE" ]; then
  PATH=$root/code/fixtures:$root/scripts:$PATH
else
  PATH=$root/scripts:$PATH
fi
export PATH

rl=$root/scripts/rl

stop_daemon() {
  [ -f "$RELAY_HOME/run/rld.pid" ] || return 0
  "$rl" daemon stop >/dev/null 2>&1 || true
}

case ${1:-} in
  env)
    echo "export RELAY_HOME=$RELAY_HOME"
    echo "export PATH=$PATH"
    ;;

  stop)
    stop_daemon
    echo "live: daemon stopped"
    ;;

  reset)
    stop_daemon
    rm -rf "$live/home" "$live/ws"
    mkdir -p "$live/home"
    cp -R "$seed/ws" "$live/ws"
    # Its own repo, so it has its own branch instead of inheriting relay's.
    git -C "$live/ws" init -q -b demo 2>/dev/null || true
    for f in schedules reactions; do
      sed "s|@LIVE@|$live|g" "$seed/$f.yaml" > "$live/home/$f.yaml"
    done
    echo "live: home $live/home, workspace $live/ws"
    "$rl" daemon start
    "$rl" up --yes "$live/ws"
    "$rl" schedule ls
    "$rl" react ls
    echo
    echo "live: now try \`scripts/live\` (the control panel), \`scripts/live ls --all\`,"
    echo "      or \`eval \"\$(scripts/live env)\"\` to use plain \`rl\` in this shell."
    ;;

  *)
    exec "$rl" "$@"
    ;;
esac
