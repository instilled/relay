#!/bin/sh
# Dev shim for `rl`: build if anything changed, then run the built binary.
# `scripts/rl` is a symlink to this file; `scripts/install` links it onto
# your PATH (by hand: ln -sf "$PWD/scripts/rl" ~/.local/bin/).
#
# Knobs:
#   RELAY_DEV_NOBUILD=1        skip the build check (just run)
#   RELAY_DEV_PROFILE=release  use target/release instead of target/debug
#
# The real binaries find each other as siblings in target/<profile>/, so
# `rl new` spawns the freshly built `rl-session`. A session already held
# keeps the `rl-session` it was started with.
set -e

# Resolve symlinks to find the repo this shim belongs to, wherever it was
# cloned and however it was linked.
self=$0
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
root=$(cd "$(dirname "$self")/.." && pwd)
name=$(basename "$0")
case $name in
  rl) ;;
  *) echo "relay-dev: call me as rl (symlink), not $name" >&2; exit 2 ;;
esac

profile=${RELAY_DEV_PROFILE:-debug}
case $profile in
  debug|release) ;;
  *) echo "relay-dev: RELAY_DEV_PROFILE is debug or release, not $profile" >&2; exit 2 ;;
esac
bindir="$root/target/$profile"
bin="$bindir/$name"

if [ -z "$RELAY_DEV_NOBUILD" ]; then
  stale=1
  if [ -x "$bin" ] && [ -x "$bindir/rl-session" ]; then
    newer=$(find "$root/code" "$root/detect" "$root/vendor" "$root/Cargo.toml" "$root/Cargo.lock" \
      -type f -newer "$bin" 2>/dev/null | head -n 1)
    [ -z "$newer" ] && stale=0
  fi
  if [ "$stale" = 1 ]; then
    if ! command -v cargo >/dev/null 2>&1; then
      echo "relay-dev: cargo is not on PATH; install Rust (https://rustup.rs) or run scripts/install" >&2
      exit 1
    fi
    echo "building relay ($profile)…" >&2
    # Quiet when it works; cargo's errors when it does not.
    if [ "$profile" = release ]; then
      (cd "$root" && cargo build -q --workspace --bins --release) || {
        echo "relay-dev: the build failed (above); rl was not run" >&2; exit 1; }
    else
      (cd "$root" && cargo build -q --workspace --bins) || {
        echo "relay-dev: the build failed (above); rl was not run" >&2; exit 1; }
    fi
    # Cargo leaves a binary untouched when only a file it ignores changed
    # (a test, a fixture); touch it so the next run does not build again.
    touch "$bin"
  fi
fi

exec "$bin" "$@"
