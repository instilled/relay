#!/bin/sh
# Makes the README's screenshots (docs/img/*.svg) from a made-up Relay, on
# the demo scripts/demo-stage sets up: nothing of yours is shown or touched.
#
#   scripts/screenshots          build, stage the demo, capture, write SVGs
#   KEEP=1 scripts/screenshots   keep the temp dir (its path is printed)
#
# Needs tmux and python3. The list runs in tmux at 110x30; each view is
# `tmux capture-pane -e` (ANSI), turned into SVG by scripts/ansi2svg.py.
set -e

self=$0
while [ -L "$self" ]; do
  t=$(readlink "$self")
  case $t in
    /*) self=$t ;;
    *) self=$(dirname "$self")/$t ;;
  esac
done
root=$(cd "$(dirname "$self")/.." && pwd -P)
out="$root/docs/img"

sock="relay-shots-$$"
# shellcheck source=scripts/demo-stage
. "$root/scripts/demo-stage"

# --- capture ----------------------------------------------------------------

mkdir -p "$out"

# The setup wizard first, in a window of its own: `rl setup` on a terminal.
# Its inline viewport is 24 rows, from the top of the fresh pane.
tm -f /dev/null new-session -d -s setup -x 110 -y 30 -c "$work" "rl setup; sleep 100000"
tm set -g default-terminal tmux-256color
tm set -as terminal-features ',*:RGB'
tm set -g status off
sleep 3

shot_in() { # shot_in <session> <rows> <name> <title>
  tm capture-pane -e -p -t "$1" >"$tmp/$3.ansi"
  "$python" "$root/scripts/ansi2svg.py" --cols 110 --rows "$2" --title "$4" <"$tmp/$3.ansi" >"$out/$3.svg"
  echo "wrote docs/img/$3.svg" >&2
}
skeys() { tm send-keys -t setup "$@"; sleep 1; }

shot_in setup 24 setup-found "rl setup — walk through it, or tab for the quick way"
skeys Enter
shot_in setup 24 setup-changes "rl setup — what changes, each one ticked or not"
skeys Enter
sleep 2
skeys Enter   # step 4, codex's /hooks
skeys Enter
shot_in setup 24 setup-keys "rl setup — the keys you'll use"
skeys C-j
shot_in setup 24 setup-now "rl setup — what you can do now"
skeys Enter
tm kill-session -t setup

tm new-session -d -s shots -x 110 -y 30 -c "$work" "rl"
sleep 4

shot() { # shot <name>
  shot_in shots 30 "$1" "$2"
}
keys() { tm send-keys -t shots "$@"; sleep 1; }

# Pin the first agent (ctrl+t), then go back to the top.
keys C-t
keys Home
shot list "rl — the list, by project"

keys -l "codex fix the flaky test"
shot command-line "rl — typing starts an agent"
keys Escape

keys C-h
shot help "rl — every key (ctrl+h)"
keys Escape

keys -l "/co"
keys Tab
shot slash "rl — / commands complete"
keys Escape

keys C-s
shot by-state "rl — grouped by state"

# Back by project; shells off (ctrl+l), hidden shown (ctrl+o).
keys C-s
keys C-l
keys C-o
shot filters "rl — shells off, hidden shown (ctrl+l, ctrl+o)"

PATH=$real_path
# Nothing of the real machine may be in a picture.
if grep -l -e "$tmp" -e "$real_home" -e "$(dirname "$root")" -e "/Users/" "$out"/*.svg 2>/dev/null; then
  echo "screenshots: a real path is in the SVGs above" >&2
  exit 1
fi
