#!/bin/sh
# notion-task <title> <cause> — create a Notion task. Wired as the action a
# `log.issue` decision runs when you approve `create`, so a task is made only
# on your say-so.
#
# You provide: $NOTION_TOKEN and $NOTION_DATABASE_ID.
set -eu

title=${1:?usage: notion-task <title> <cause>}
cause=${2:-}

curl -sS -X POST https://api.notion.com/v1/pages \
  -H "Authorization: Bearer $NOTION_TOKEN" \
  -H "Notion-Version: 2022-06-28" \
  -H "Content-Type: application/json" \
  --data @- <<JSON
{
  "parent": { "database_id": "$NOTION_DATABASE_ID" },
  "properties": {
    "Name": { "title": [ { "text": { "content": $(printf '%s' "$title" | jq -Rs .) } } ] }
  },
  "children": [
    { "object": "block", "type": "paragraph",
      "paragraph": { "rich_text": [ { "text": { "content": $(printf '%s' "$cause" | jq -Rs .) } } ] } }
  ]
}
JSON
