#!/bin/sh
# check-weather — today's forecast (no API key) in one line, when it is sunny or
# the chance of rain is above a threshold; nothing otherwise. The flow's probe
# step runs this (the flow's folder is first on its PATH), and what it prints
# is the step's out: `{probe.out}` in the question. Needs only curl and jq.
#
# Configure with WEATHER_LAT / WEATHER_LON / WEATHER_PLACE, and the rain
# threshold with RAIN_POP (percent, default 50).
set -eu

lat=${WEATHER_LAT:-47.37}
lon=${WEATHER_LON:-8.55}
place=${WEATHER_PLACE:-Zurich}
threshold=${RAIN_POP:-50}

url="https://api.open-meteo.com/v1/forecast?latitude=$lat&longitude=$lon&daily=weather_code,precipitation_probability_max&forecast_days=1&timezone=auto"
day=$(curl -sS "$url" | jq -c '.daily')
code=$(printf '%s' "$day" | jq -r '.weather_code[0]')
pop=$(printf '%s' "$day" | jq -r '.precipitation_probability_max[0] // 0')

# WMO weather codes 0 (clear) and 1 (mainly clear) read as "sunny".
if [ "$code" = 0 ] || [ "$code" = 1 ]; then
  echo "$(date +%F) sunny in $place (rain $pop%)"
elif awk -v p="$pop" -v t="$threshold" 'BEGIN { exit !(p > t) }'; then
  echo "$(date +%F) rain likely in $place (rain $pop%)"
fi
