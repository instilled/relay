#!/bin/sh
# The stand-in `rl`'s tests run for a harness with a background of its own
# (`sources::adapter_bin`), never the real one. It writes what it was run
# with to `argv` in the folder it is run in; asked to start one in the
# background, it says `0a1b2c3d`, where, and how to attach. What it lists is
# the tests' to say (`sources::StandIn`). Its `rm` refuses, as `claude rm`
# does a session with unpushed commits, where the folder has a `refuse-rm`:
# what is in it, said on stderr, and exit 1. Its `logs <id>` prints what a
# terminal of the session's showed, as `claude logs` does: a styled line,
# then one drawn over in place; where the folder has a `peek-slow`, only
# after that many seconds.
if [ "$1" = logs ]; then
  [ -f peek-slow ] && sleep "$(cat peek-slow)"
  printf '\033[1m%s\033[m is at work\r\nstep 1\r\033[2Kstep 2 of 3\r\n' "$2"
  exit 0
fi
printf '%s\n' "$@" > argv
if [ "$1" = rm ] && [ -f refuse-rm ]; then
  cat refuse-rm >&2
  exit 1
fi
case " $* " in
*' --bg '*) echo "started 0a1b2c3d in $PWD · claude attach 0a1b2c3d" ;;
esac
