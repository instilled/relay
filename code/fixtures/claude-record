#!/usr/bin/env python3
"""Records a Claude Code session as a fixture for the player (`./claude`):
what Claude printed (stream-json, one event per line) and the hook payloads
it sent, each stamped with milliseconds since start.

    claude-record OUT.jsonl [CLAUDE ARGS…] PROMPT

Dev-time only: needs a logged-in `claude`. Runs headless (`-p`), so a tool
call needs `--allowedTools`. Paths under the recording directory and the
transcript path are replaced with placeholders before writing.

Lines in OUT.jsonl:
    {"t": ms, "out": <stream-json event>}
    {"t": ms, "hook": "<Event>", "payload": <what Claude sent on stdin>}
    {"t": ms, "exit": <code>}
"""
import json
import os
import shlex
import subprocess
import sys
import tempfile
import time

EVENTS = ["SessionStart", "UserPromptSubmit", "PreToolUse", "PostToolUse", "Notification", "Stop"]


def now_ms():
    return int(time.time() * 1000)


def append(path, obj):
    with open(path, "a") as f:
        f.write(json.dumps(obj, ensure_ascii=False) + "\n")


def hook(event, out):
    t0 = int(os.environ.get("CLAUDE_RECORD_T0", "0"))
    try:
        payload = json.loads(sys.stdin.read() or "null")
    except json.JSONDecodeError:
        payload = None
    append(out, {"t": now_ms() - t0, "hook": event, "payload": payload})


DROP = {("system", "hook_started"), ("system", "hook_response"), ("system", "thinking_tokens"), ("rate_limit_event", None)}
KEEP = {
    "init": ["type", "subtype", "cwd", "session_id", "model", "permissionMode", "claude_code_version", "tools"],
    "message": ["type", "session_id", "timestamp", "message"],
    "message.message": ["role", "model", "content", "stop_reason"],
    "result": ["type", "subtype", "is_error", "result", "duration_ms", "num_turns", "total_cost_usd", "session_id",
               "stop_reason", "permission_denials"],
}
PATH_KEYS = {"cwd": "/work", "transcript_path": "/home/user/.claude/transcript.jsonl", "scratchpad_dir": "/work/.scratch"}


def keep(d, keys):
    return {k: d[k] for k in keys if k in d}


def scrub(obj, cwd):
    """Real paths and account noise out of the fixture."""
    if isinstance(obj, dict):
        return {k: (PATH_KEYS[k] if k in PATH_KEYS and isinstance(obj[k], str) else scrub(v, cwd)) for k, v in obj.items()}
    if isinstance(obj, list):
        return [scrub(v, cwd) for v in obj]
    if isinstance(obj, str):
        return obj.replace(cwd, "/work").replace(os.path.expanduser("~"), "/home/user")
    return obj


def trim(ev):
    """The parts of a stream-json event the player and a reader need. None to drop."""
    kind, sub = ev.get("type"), ev.get("subtype")
    if (kind, sub) in DROP or (kind, None) in DROP:
        return None
    if kind == "system" and sub == "init":
        ev = keep(ev, KEEP["init"])
        ev["tools"] = [t for t in ev.get("tools", []) if not t.startswith("mcp__")]
    elif kind in ("assistant", "user"):
        ev = keep(ev, KEEP["message"])
        ev["message"] = keep(ev.get("message", {}), KEEP["message.message"])
        ev["message"]["content"] = [
            {k: v for k, v in b.items() if k != "signature"} if isinstance(b, dict) else b
            for b in ev["message"].get("content", [])
        ]
    elif kind == "result":
        ev = keep(ev, KEEP["result"])
    return ev


def record(out, args):
    out = os.path.abspath(out)
    if os.path.exists(out):
        os.remove(out)
    me = os.path.abspath(__file__)
    hooks = {
        ev: [{"hooks": [{"type": "command", "command": f"{shlex.quote(me)} --hook {ev} {shlex.quote(out)}", "timeout": 10}]}]
        for ev in EVENTS
    }
    with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
        json.dump({"hooks": hooks}, f)
        settings = f.name
    t0 = now_ms()
    env = dict(os.environ, CLAUDE_RECORD_T0=str(t0))
    cmd = ["claude", "-p", "--output-format", "stream-json", "--verbose", "--settings", settings, *args]
    print("recording:", " ".join(shlex.quote(c) for c in cmd), file=sys.stderr)
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, env=env, text=True)
    for line in proc.stdout:
        line = line.strip()
        if not line:
            continue
        try:
            ev = json.loads(line)
        except json.JSONDecodeError:
            print("not json:", line, file=sys.stderr)
            continue
        kind = ev.get("type")
        sub = ev.get("subtype")
        ev = trim(ev)
        if ev is None:
            continue
        append(out, {"t": now_ms() - t0, "out": ev})
        print(f"  {kind}{'/' + sub if sub else ''}", file=sys.stderr)
    code = proc.wait()
    append(out, {"t": now_ms() - t0, "exit": code})
    os.remove(settings)

    # Hooks and the reader wrote concurrently; order by time and scrub.
    cwd = os.getcwd()
    with open(out) as f:
        lines = [json.loads(l) for l in f if l.strip()]
    lines.sort(key=lambda l: l["t"])
    with open(out, "w") as f:
        for l in lines:
            f.write(json.dumps(scrub(l, cwd), ensure_ascii=False) + "\n")
    hooks_seen = [l["hook"] for l in lines if "hook" in l]
    print(f"wrote {out}: {len(lines)} lines, exit {code}, hooks: {' '.join(hooks_seen)}", file=sys.stderr)
    return code


def main():
    argv = sys.argv[1:]
    if len(argv) >= 3 and argv[0] == "--hook":
        hook(argv[1], argv[2])
        return 0
    if len(argv) < 2:
        print(__doc__, file=sys.stderr)
        return 2
    return record(argv[0], argv[1:])


if __name__ == "__main__":
    sys.exit(main())
