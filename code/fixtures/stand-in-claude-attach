#!/usr/bin/env python3
# A stand-in for `claude attach <id>` on a terminal, never the real one: it
# draws a Claude screen as Claude 2.1.322 does (its transcript, then its
# input line between two rules, `❯` and a no-break space), takes keys, and
# appends each line entered to `<dir>/typed`. Run as
#
#   stand-in-claude-attach <variant> <dir>
#
# where the variant is how the session stands:
#
#   idle   its input line empty: what is typed shows there; enter takes it
#   busy   the same, and a turn running (`esc to interrupt`)
#   dirty  something typed on its input line already
#   blank  nothing of Claude's drawn at all
#   deaf   idle, but what is typed never shows
#
# It runs until it is hung up on.
import os, sys, termios, tty

variant, out = sys.argv[1], sys.argv[2]
fd = sys.stdin.fileno()
if os.isatty(fd):
    tty.setraw(fd)

transcript = ["❯ Reply with just the word hi.", "", "⏺ hi", ""]
typed = "half a thought" if variant == "dirty" else ""
RULE = "─" * 60


def draw():
    if variant == "blank":
        lines = ["loading…"]
    else:
        lines = list(transcript)
        if variant == "busy":
            lines.append("✻ Working… (3s · esc to interrupt)")
        lines += [RULE, "❯ " + typed, RULE, "  ~/shop · main"]
    os.write(1, ("\x1b[2J\x1b[H" + "\r\n".join(lines)).encode())


draw()
while True:
    b = os.read(fd, 1024)
    if not b:
        break
    if variant == "deaf":
        continue
    for c in b.decode(errors="replace"):
        if c == "\r":
            if typed:
                with open(os.path.join(out, "typed"), "a") as f:
                    f.write(typed + "\n")
                transcript += ["❯ " + typed, ""]
            typed = ""
        elif c == "\x15":
            typed = ""
        else:
            typed += c
    draw()
