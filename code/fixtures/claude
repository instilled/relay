#!/usr/bin/env python3
"""A stand-in for `claude` that replays a recorded session (see claude-record):
prints what Claude printed, sends the hooks Claude sent, exits as Claude
exited. It reads `--settings FILE` from its arguments the way Claude does, so
a run under Relay reports back through the real hook path; every other
argument is ignored. Put this directory first on PATH and `rl run --agent
claude` runs it.

Headless (`-p`): the replay, then the result text, then exit. Interactive
(no `-p`): the replay, then a `>` prompt; each line typed replays the
recorded turn again as if it were the answer; `exit` or EOF ends it.

    CLAUDE_PLAYER_FIXTURE   the recording (default: claude-session.jsonl beside this file)
    CLAUDE_PLAYER_SPEED     playback speed; 0 skips every wait (default 1)
    CLAUDE_PLAYER_MAX_GAP   longest wait between lines, seconds (default 2)
"""
import json
import os
import re
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))


def load(path):
    with open(path) as f:
        return [json.loads(l) for l in f if l.strip()]


def parse_args(argv):
    settings, print_mode, prompt = None, False, None
    it = iter(argv)
    for a in it:
        if a == "--settings":
            settings = next(it, None)
        elif a.startswith("--settings="):
            settings = a.split("=", 1)[1]
        elif a in ("-p", "--print"):
            print_mode = True
        elif a in ("--version", "-v"):
            print("2.1.266 (Claude Code, relay fixture player)")
            sys.exit(0)
        elif a in ("--model", "--allowedTools", "--output-format", "--permission-mode", "--add-dir"):
            next(it, None)
        elif not a.startswith("-"):
            prompt = a
    return settings, print_mode, prompt


class Hooks:
    def __init__(self, settings):
        self.by_event = {}
        if settings and os.path.isfile(settings):
            with open(settings) as f:
                self.by_event = json.load(f).get("hooks", {})

    def fire(self, event, payload):
        for entry in self.by_event.get(event, []):
            matcher = entry.get("matcher")
            if matcher and not re.search(matcher, payload.get("tool_name", "")):
                continue
            for h in entry.get("hooks", []):
                if h.get("type") != "command":
                    continue
                try:
                    subprocess.run(
                        ["sh", "-c", h["command"]],
                        input=json.dumps(payload),
                        text=True,
                        capture_output=True,
                        timeout=h.get("timeout", 5),
                    )
                except (subprocess.TimeoutExpired, OSError):
                    pass


def out(s=""):
    sys.stdout.write(s + "\r\n" if s else "\r\n")
    sys.stdout.flush()


def tool_line(block):
    name, inp = block.get("name", "?"), block.get("input", {})
    if name == "Bash" and "command" in inp:
        arg = inp["command"]
    else:
        arg = json.dumps(inp)[:60]
    return f"⏺ {name}({arg})"


def result_line(block):
    c = block.get("content", "")
    if isinstance(c, list):
        c = " ".join(b.get("text", "") for b in c if isinstance(b, dict))
    first = (c or "(no output)").splitlines()[0]
    return f"  ⎿  {first}"


def render(ev, print_mode):
    kind, sub = ev.get("type"), ev.get("subtype")
    if kind == "system" and sub == "init":
        if not print_mode:
            out(f"✻ Claude Code v{ev.get('claude_code_version', '?')} · {ev.get('model', '?')} · recorded session, replayed")
            out()
    elif kind == "assistant":
        for b in ev["message"].get("content", []):
            if b.get("type") == "text" and b.get("text"):
                out(f"⏺ {b['text']}")
            elif b.get("type") == "tool_use":
                out(tool_line(b))
    elif kind == "user":
        for b in ev["message"].get("content", []):
            if b.get("type") == "tool_result":
                out(result_line(b))
    elif kind == "result" and print_mode:
        out(ev.get("result", ""))


class Player:
    def __init__(self, lines, hooks, print_mode):
        self.lines, self.hooks, self.print_mode = lines, hooks, print_mode
        self.speed = float(os.environ.get("CLAUDE_PLAYER_SPEED", "1"))
        self.max_gap = float(os.environ.get("CLAUDE_PLAYER_MAX_GAP", "2"))
        self.code = 0

    def wait(self, prev, t):
        if self.speed > 0 and t > prev:
            time.sleep(min((t - prev) / 1000.0 / self.speed, self.max_gap))

    def play(self, lines, prompt=None):
        prev = lines[0]["t"] if lines else 0
        for l in lines:
            self.wait(prev, l["t"])
            prev = l["t"]
            if "hook" in l:
                payload = dict(l["payload"] or {})
                if prompt is not None and l["hook"] == "UserPromptSubmit":
                    payload["prompt"] = prompt
                self.hooks.fire(l["hook"], payload)
            elif "out" in l:
                render(l["out"], self.print_mode)
            elif "exit" in l:
                self.code = int(l["exit"])

    def run(self):
        self.play(self.lines)
        if self.print_mode:
            return self.code
        # A turn again for every line typed, the way a session keeps going.
        turn = [l for l in self.lines if not ("hook" in l and l["hook"] == "SessionStart")
                and not ("out" in l and l["out"].get("subtype") == "init")]
        while True:
            sys.stdout.write("\r\n> ")
            sys.stdout.flush()
            try:
                line = sys.stdin.readline()
            except KeyboardInterrupt:
                return 130
            if not line or line.strip() in ("exit", "/exit", "/quit"):
                out()
                return self.code
            out()
            self.play(turn, prompt=line.strip())


def main():
    settings, print_mode, _prompt = parse_args(sys.argv[1:])
    fixture = os.environ.get("CLAUDE_PLAYER_FIXTURE") or os.path.join(HERE, "claude-session.jsonl")
    player = Player(load(fixture), Hooks(settings), print_mode)
    return player.run()


if __name__ == "__main__":
    sys.exit(main())
